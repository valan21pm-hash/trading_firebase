{
  "entities": {
    "BrokerCredentials": {
      "title": "Broker Credentials",
      "description": "Sensitive credentials for trading brokers",
      "type": "object",
      "properties": {
        "alpaca": { "type": "object" }
      }
    },
    "BotSettings": {
      "title": "Bot Settings",
      "description": "Global settings for the trading bot",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "lastCheck": { "type": "string" }
      }
    },
    "BotData": {
      "title": "Bot Data",
      "description": "Runtime data for the bot in a specific mode",
      "type": "object",
      "properties": {
        "balance": { "type": "number" },
        "dailyPnL": { "type": "array" }
      }
    },
    "LogEntry": {
      "title": "Log Entry",
      "description": "Generic log entry",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "message": { "type": "string" },
        "level": { "type": "string" }
      }
    },
    "LogicLog": {
      "title": "Logic Log",
      "description": "Detailed trading logic logs",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "symbol": { "type": "string" },
        "action": { "type": "string" },
        "reasoning": { "type": "string" }
      }
    },
    "SentimentCache": {
      "title": "Sentiment Cache",
      "description": "Cached market sentiment analysis",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "sentiment": { "type": "string" },
        "reasoning": { "type": "string" },
        "timestamp": { "type": "number" }
      }
    },
    "GeminiSignal": {
      "title": "Gemini Signal",
      "description": "Signals generated by Gemini AI",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "signal": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "TrendingStock": {
      "title": "Trending Stock",
      "description": "Daily trending stocks info",
      "type": "object",
      "properties": {
        "stocks": { "type": "array" },
        "timestamp": { "type": "string" }
      }
    },
    "AlpacaPosition": {
      "title": "Alpaca Position",
      "description": "Active trading position on Alpaca",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "qty": { "type": "number" },
        "avg_entry_price": { "type": "number" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "broker_credentials": {
      "schema": "BrokerCredentials",
      "description": "Storage for broker API keys"
    },
    "settings": {
      "schema": "BotSettings",
      "description": "Global bot configuration"
    },
    "bot_data": {
      "schema": "BotData",
      "description": "Mode-specific bot data (paper/live)"
    },
    "logic_logs": {
      "schema": "LogicLog",
      "description": "Historical trading decisions"
    },
    "operational_logs": {
      "schema": "LogEntry",
      "description": "General system logs"
    },
    "sentiment_cache": {
      "schema": "SentimentCache",
      "description": "Cached AI analyses"
    },
    "gemini_signals": {
      "schema": "GeminiSignal",
      "description": "Live AI signals"
    },
    "trending_stocks": {
      "schema": "TrendingStock",
      "description": "Market trends"
    },
    "alpaca_positions": {
      "schema": "AlpacaPosition",
      "description": "Currently open positions"
    }
  }
}
